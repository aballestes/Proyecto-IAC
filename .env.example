# ============================================================================
# .env.example — Variables de Entorno para Proyecto IaC VMware
# ============================================================================
# 
# INSTRUCCIONES:
# 1. Copiar este archivo como .env:
#    cp .env.example .env
#
# 2. Editar .env y completar con valores reales (passwords, IPs, etc.)
#
# 3. Cargar en shell actual:
#    source .env
#
# 4. Agregar a .bashrc para carga automática (opcional):
#    echo "source ~/proyecto-iaac/.env" >> ~/.bashrc
#
# IMPORTANTE: El archivo .env está en .gitignore y NO debe commitearse
# ============================================================================

# ----------------------------------------------------------------------------
# vCenter Contingencia
# ----------------------------------------------------------------------------
export VCENTER_CONT_HOST="vcenter-cont.dominio.local"
export VCENTER_CONT_USER="svc-ansible@vsphere.local"
export VCENTER_CONT_PASSWORD=""  # ⚠️ Completar aquí o dejar vacío para prompt interactivo
export VCENTER_CONT_DATACENTER="DATACENTER CONTINGENCIA"
export VCENTER_CONT_CLUSTER="cluster-cont"

# ----------------------------------------------------------------------------
# vCenter Producción
# ----------------------------------------------------------------------------
export VCENTER_PROD_HOST="vcenter-prod.dominio.local"
export VCENTER_PROD_USER="svc-ansible@vsphere.local"
export VCENTER_PROD_PASSWORD=""  # ⚠️ Completar aquí o dejar vacío para prompt interactivo
export VCENTER_PROD_DATACENTER="DATACENTER PRODUCCION"
export VCENTER_PROD_CLUSTER_APP="cluster-app"
export VCENTER_PROD_CLUSTER_DB="cluster-db"

# ----------------------------------------------------------------------------
# Terraform Configuration
# ----------------------------------------------------------------------------
export TF_LOG=""                              # Debug: TRACE, DEBUG, INFO, WARN, ERROR
export TF_LOG_PATH="./terraform.log"          # Archivo de logs
export TF_DATA_DIR=".terraform"
export TF_PLUGIN_CACHE_DIR="$HOME/.terraform.d/plugin-cache"

# Terraform Backend (MinIO/S3)
export TF_BACKEND_BUCKET="terraform-state"
export TF_BACKEND_ENDPOINT="https://minio.dominio.local"
export TF_BACKEND_ACCESS_KEY=""               # ⚠️ Completar con Access Key de MinIO
export TF_BACKEND_SECRET_KEY=""               # ⚠️ Completar con Secret Key de MinIO
export TF_BACKEND_REGION="us-east-1"

# ----------------------------------------------------------------------------
# Ansible Configuration
# ----------------------------------------------------------------------------
export ANSIBLE_HOST_KEY_CHECKING="False"
export ANSIBLE_STDOUT_CALLBACK="yaml"
export ANSIBLE_CALLBACKS_ENABLED="profile_tasks,timer"
export ANSIBLE_GATHERING="smart"
export ANSIBLE_FACT_CACHING="jsonfile"
export ANSIBLE_FACT_CACHING_CONNECTION="/tmp/ansible_facts"
export ANSIBLE_FACT_CACHING_TIMEOUT="3600"
export ANSIBLE_SSH_RETRIES="3"
export ANSIBLE_TIMEOUT="30"

# Inventario dinámico VMware
export VMWARE_VALIDATE_CERTS="False"
export VMWARE_SERVER="$VCENTER_CONT_HOST"    # Cambiar según ambiente
export VMWARE_USERNAME="$VCENTER_CONT_USER"
export VMWARE_PASSWORD="$VCENTER_CONT_PASSWORD"

# ----------------------------------------------------------------------------
# Python Configuration
# ----------------------------------------------------------------------------
export PYTHONUNBUFFERED="1"
export PYTHONDONTWRITEBYTECODE="1"
export PYTHONIOENCODING="utf-8"

# PyVmomi (vSphere SDK)
export PYVMOMI_VERIFY_SSL="False"

# ----------------------------------------------------------------------------
# Git Configuration
# ----------------------------------------------------------------------------
export GIT_AUTHOR_NAME="IaC Team"
export GIT_AUTHOR_EMAIL="iac-team@dominio.local"
export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"

# ----------------------------------------------------------------------------
# Sistema Operativo (Ubuntu/WSL)
# ----------------------------------------------------------------------------
# Colores en terminal
export CLICOLOR="1"
export LSCOLORS="GxFxCxDxBxegedabagaced"
export TERM="xterm-256color"

# Editor por defecto
export EDITOR="vim"
export VISUAL="vim"

# Locale
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# ----------------------------------------------------------------------------
# Rutas del Proyecto
# ----------------------------------------------------------------------------
# Detectar si estamos en WSL
if grep -qi microsoft /proc/version 2>/dev/null; then
    export PROJECT_ROOT="/mnt/c/BACKUP SEPTIEMBRE/GIFHUB/PROYECTO IAAC"
else
    # Linux nativo o VM
    export PROJECT_ROOT="$(pwd)"
fi

export TERRAFORM_DIR="$PROJECT_ROOT/terraform"
export ANSIBLE_DIR="$PROJECT_ROOT/ansible"
export SCRIPTS_DIR="$PROJECT_ROOT/scripts"

# ----------------------------------------------------------------------------
# Alias útiles
# ----------------------------------------------------------------------------
alias tf='terraform'
alias tfi='terraform init'
alias tfp='terraform plan'
alias tfa='terraform apply'
alias tfd='terraform destroy'
alias tfv='terraform validate'
alias tff='terraform fmt -recursive'

alias ap='ansible-playbook'
alias ai='ansible-inventory'
alias av='ansible-vault'

alias ll='ls -lahF'
alias la='ls -A'
alias grep='grep --color=auto'

alias proj='cd "$PROJECT_ROOT"'
alias proj-tf='cd "$TERRAFORM_DIR"'
alias proj-ans='cd "$ANSIBLE_DIR"'
alias proj-scripts='cd "$SCRIPTS_DIR"'

# ----------------------------------------------------------------------------
# Funciones útiles
# ----------------------------------------------------------------------------

# Función para cambiar de ambiente vCenter
vcenter-switch() {
    if [ "$1" = "cont" ]; then
        export VMWARE_SERVER="$VCENTER_CONT_HOST"
        export VMWARE_USERNAME="$VCENTER_CONT_USER"
        export VMWARE_PASSWORD="$VCENTER_CONT_PASSWORD"
        echo "[✓] Ambiente cambiado a: CONTINGENCIA ($VCENTER_CONT_HOST)"
    elif [ "$1" = "prod" ]; then
        export VMWARE_SERVER="$VCENTER_PROD_HOST"
        export VMWARE_USERNAME="$VCENTER_PROD_USER"
        export VMWARE_PASSWORD="$VCENTER_PROD_PASSWORD"
        echo "[✓] Ambiente cambiado a: PRODUCCIÓN ($VCENTER_PROD_HOST)"
    else
        echo "[!] Uso: vcenter-switch {cont|prod}"
    fi
}

# Función para ejecutar inventario rápido
inventory() {
    local env=${1:-cont}
    local format=${2:-csv}
    cd "$SCRIPTS_DIR/discovery"
    ./run-inventory.sh "$env" "$format"
    cd - > /dev/null
}

# Función para mostrar estado del proyecto
project-status() {
    echo "╔═══════════════════════════════════════════════════════════════╗"
    echo "║             Estado del Proyecto IaC VMware                    ║"
    echo "╚═══════════════════════════════════════════════════════════════╝"
    echo ""
    echo "📁 Directorio actual: $(pwd)"
    echo "📂 Proyecto root:     $PROJECT_ROOT"
    echo ""
    echo "🔧 Herramientas:"
    echo "  • Python:    $(python3 --version 2>&1 | awk '{print $2}')"
    echo "  • Terraform: $(terraform version -json 2>/dev/null | jq -r '.terraform_version' 2>/dev/null || echo 'No instalado')"
    echo "  • Ansible:   $(ansible --version 2>/dev/null | head -n1 | awk '{print $3}' | tr -d '[]' || echo 'No instalado')"
    echo "  • Git:       $(git --version 2>/dev/null | awk '{print $3}' || echo 'No instalado')"
    echo ""
    echo "🌐 vCenter Actual:"
    echo "  • Host:      ${VMWARE_SERVER:-No configurado}"
    echo "  • Usuario:   ${VMWARE_USERNAME:-No configurado}"
    echo ""
}

# ----------------------------------------------------------------------------
# Banner de bienvenida
# ----------------------------------------------------------------------------
echo ""
echo "╔═══════════════════════════════════════════════════════════════╗"
echo "║                                                               ║"
echo "║     ✓ Variables de entorno IaC cargadas                      ║"
echo "║                                                               ║"
echo "╚═══════════════════════════════════════════════════════════════╝"
echo ""
echo "Comandos disponibles:"
echo "  • vcenter-switch {cont|prod}  → Cambiar ambiente"
echo "  • inventory {cont|prod} [csv] → Ejecutar inventario"
echo "  • project-status              → Ver estado del proyecto"
echo "  • proj-scripts                → Ir a carpeta scripts"
echo ""
